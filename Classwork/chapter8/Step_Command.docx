1.) cd manning-smia-master\chapter8
    mvn clean package dockerfile:build
    cd docker
    docker-compose -p chapter8 up

2.) Invoke-RestMethod `
    -Uri "http://localhost:8072/actuator/gateway/routes" `
    -Method Get |
    ConvertTo-Json -Depth 10

3.) 1.) $organizationId = "d898a142-de44-466c-8c88-9ceb2c2429d3"

        Invoke-RestMethod `
        -Uri "http://localhost:8072/organization/v1/organization/$organizationId" `
        -Method Get |
        ConvertTo-Json -Depth 10
    
    2.) $licenseId = "f2a9c9d4-d2c0-44fa-97fe-724d77173c62"

        Invoke-RestMethod `
        -Uri "http://localhost:8072/license/v1/organization/$organizationId/license/$licenseId" `
        -Method Get |
        ConvertTo-Json -Depth 10

4.) 1.) Invoke-WebRequest `
        -Uri "http://localhost:8072/license/v1/organization/$organizationId/license/$licenseId" `
        -Method Get |
        Select-Object -ExpandProperty Headers

    2.) docker compose -p chapter8 -f ".\docker\docker-compose.yml" logs --tail 200 gatewayserver |
        Select-String -Pattern "correlation|tracking|tmx"

    3.) docker compose -p chapter8 -f ".\docker\docker-compose.yml" logs --tail 200 licensingservice |
        Select-String -Pattern "Correlation|correlation|tmx" 

    4.) docker compose -p chapter8 -f ".\docker\docker-compose.yml" logs --tail 200 licensingservice |
        Select-String -Pattern "Correlation|correlation|tmx"  

    5.) $response = Invoke-WebRequest `
        -Uri "http://localhost:8072/license/v1/organization/$organizationId/license/$licenseId" `
        -Method Get `
        -UseBasicParsing

        Write-Host "`n--- RESPONSE CORRELATION ID ---" -ForegroundColor Cyan

        $response.Headers["tmx-correlation-id"] 
    
    6.) docker compose -p chapter8 -f ".\docker\docker-compose.yml" logs --tail 200 licensingservice |
        Select-String -Pattern "Correlation|correlation|tmx"

        Write-Host "`n--- SENDING REQUEST THROUGH GATEWAY ---" -ForegroundColor Cyan

    7.) $response = Invoke-WebRequest `
        -Uri "http://localhost:8072/license/v1/organization/$organizationId/license/$licenseId" `
        -Method Get `
        -UseBasicParsing

        Write-Host "`n--- HTTP STATUS ---" -ForegroundColor Cyan
        $response.StatusCode

        Write-Host "`n--- CORRELATION ID RESPONSE HEADER ---" -ForegroundColor Cyan
        $response.Headers["tmx-correlation-id"]

    8.) Write-Host "`n--- GATEWAY CORRELATION LOGS ---" -ForegroundColor Cyan

        docker compose -p chapter8 -f ".\docker\docker-compose.yml" logs --since 2m gatewayserver |
        Select-String -Pattern "correlation|tracking|tmx"

    9.) Write-Host "`n--- LICENSING SERVICE CORRELATION LOGS ---" -ForegroundColor Cyan

        docker compose -p chapter8 -f ".\docker\docker-compose.yml" logs --since 2m licensingservice |
        Select-String -Pattern "Correlation|correlation|tmx"

    10.)    docker compose -p chapter8 -f ".\docker\docker-compose.yml" logs gatewayserver |
            Select-String -Pattern "b13bab42-2578-405f-8271-a9f0e31a79e8"

    11.)    docker compose -p chapter8 -f ".\docker\docker-compose.yml" logs licensingservice |
            Select-String -Pattern "b13bab42-2578-405f-8271-a9f0e31a79e8"

    12.)    docker compose -p chapter8 -f ".\docker\docker-compose.yml" logs gatewayserver |
            Select-String -Pattern "b13bab42-2578-405f-8271-a9f0e31a79e8"

    13.)   $testCorrelationId = "TEST-123"

            $response = Invoke-WebRequest `
            -Uri "http://localhost:8072/license/v1/organization/$organizationId/license/$licenseId" `
            -Method Get `
            -Headers @{ "tmx-correlation-id" = $testCorrelationId } `
            -UseBasicParsing

            Write-Host "`n--- HTTP STATUS ---" -ForegroundColor Cyan
            $response.StatusCode

            Write-Host "`n--- RETURNED CORRELATION ID ---" -ForegroundColor Cyan
            $response.Headers["tmx-correlation-id"]