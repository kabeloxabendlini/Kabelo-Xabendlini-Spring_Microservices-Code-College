    2.) docker compose -f ".\docker\docker-compose.yml" -p chapter9 ps

2.) curl.exe -i "http://localhost:8081/v1/organization/d898a142-de44-466c-8c88-9ceb2c2429d3"

3.) $tokenResponse = Invoke-RestMethod `
        -Method Post `
        -Uri "http://localhost:8083/auth/realms/spmia-realm/protocol/openid-connect/token" `
        -ContentType "application/x-www-form-urlencoded" `
        -Body @{
            grant_type    = "password"
            client_id     = "ostock"
            client_secret = $ostock.secret
            username      = "illary.huaylupo"
            password      = "password1"
        }

    $accessToken = $tokenResponse.access_token

    Write-Host "Access token successfully obtained." -ForegroundColor Green

4.) 1.) curl.exe -i `
        -H "Authorization: Bearer $accessToken" `
        "http://localhost:8081/v1/organization/d898a142-de44-466c-8c88-9ceb2c2429d3"

    2.) curl.exe -i `
        -H "Authorization: Bearer $accessToken" `
        "http://localhost:8072/license/v1/organization/d898a142-de44-466c-8c88-9ceb2c2429d3/license/f2a9c9d4-d2c0-44fa-97fe-724d77173c62"

