<?xml version="1.0" encoding="UTF-8"?>

<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.optimagrowth</groupId>
    <version>0.0.1-SNAPSHOT</version>
    <artifactId>ostock-parent-pom</artifactId>
    <packaging>pom</packaging>

    <name>optimagrowth-parent-pom</name>
    <description>Parent Pom for the optimagrowth project</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.2.3.RELEASE</version>
        <relativePath/>
    </parent>

    <properties>
        <docker.image.prefix>ostock</docker.image.prefix>

        <!-- Lombok version compatible with JDK 17 -->
        <lombok.version>1.18.32</lombok.version>
    </properties>

    <modules>
        <module>configserver</module>
        <module>eurekaserver</module>
        <module>licensing-service</module>
        <module>organization-service</module>
    </modules>

    <!--
        Spring Boot 2.2.3 manages an old Lombok version (1.18.12).
        Explicitly override it so the project can compile with JDK 17.
    -->
    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.32</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>

            <plugin>
                <groupId>com.spotify</groupId>
                <artifactId>dockerfile-maven-plugin</artifactId>
                <version>1.4.13</version>

                <configuration>
                    <skip>true</skip>
                </configuration>

            </plugin>

        </plugins>
    </build>

</project>
