4.) 1.)   1.) Invoke-RestMethod -Uri "http://localhost:9200/_cat/indices/logstash-*?format=json"

    1.)   2.)   $aggregation = @{
                    size = 0
                    aggs = @{
                        applications = @{
                            terms = @{
                                field = "application_name.keyword"
                                size = 10
                            }
                        }
                    }
                } | ConvertTo-Json -Depth 6

                $logSummary = Invoke-RestMethod `
                    -Uri "http://localhost:9200/logstash-*/_search" `
                    -Method Post `
                    -ContentType "application/json" `
                    -Body $aggregation

                $logSummary.aggregations.applications.buckets |
                    Select-Object key, doc_count |
                    Format-Table -AutoSize

